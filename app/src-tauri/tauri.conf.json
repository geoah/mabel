{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mabel",
  "version": "0.2.0",
  "identifier": "io.github.geoah.mabel",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "iOS": {
      "frameworks": [
        "SystemConfiguration"
      ]
    }
  }
}
